/**
 * PRISM model of the Daemon Protocol multi-gate pipeline.
 *
 * Sequential composition of GATE_0..GATE_4, each with local state (r_gate, sigma_sop)
 * and global shared budget (r_global). Advances on PROCEED; aborts on ROLLBACK.
 *
 * This model verifies that the pipeline never emits an unsafe network packet and
 * terminates within the global budget bound.
 */

mdp

// Gate indices
const GATE_0 = 0;
const GATE_1 = 1;
const GATE_2 = 2;
const GATE_3 = 3;
const GATE_4 = 4;

// Max budgets (product of all gates)
const K_gate = 3;
const K_global = 60; // 5 gates * 12 turns per gate

// Global state
global r_global : [0..K_global] init 0;
global current_gate : [0..5] init 0; // 5 is terminal/abort
global unsafe_emitted : bool init false;

// Per-gate module
module gate
  r_gate : [0..K_gate] init 0;
  sigma_sop : [0..1] init 0;

  // Violation: forbidden action
  [] current_gate < 5 & r_gate < K_gate & r_global < K_global ->
    (r_gate' = r_gate + 1) & (r_global' = r_global + 1);

  // SOP success: refresh gate budget
  [] current_gate < 5 & r_global < K_global ->
    (r_gate' = 0) & (sigma_sop' = 1) & (r_global' = r_global + 1);

  // Completion: legal iff sigma_sop = 1
  [] current_gate < 5 & sigma_sop = 1 & r_global < K_global ->
    (current_gate' = current_gate + 1) & (r_gate' = 0) & (sigma_sop' = 0) & (r_global' = r_global + 1);

  // Termination conditions
  [] r_gate >= K_gate | r_global >= K_global -> (current_gate' = 5);
endmodule

// Safety invariant: P1 never violated (safe for external check)
label "p1_safe" = !unsafe_emitted;

// Reachability: all gates completed
label "pipeline_proceed" = current_gate = 5 & !unsafe_emitted;
